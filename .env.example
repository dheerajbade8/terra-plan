# Copy to .env (or set these in your hosting service)
PORT=3000
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Where the SQLite file lives
DB_PATH=./data/terraplan.db
# Set to false in production to skip the demo accounts (then use: npm run create-user)
SEED_DEMO=true
